#!/usr/bin/env bash
# pj — arranque de un meta-repo hijo de robert-flo/pj-template (modo dependencia).
# Lo manda pj-template (plantillas/hijo/pj); no lo edités en el hijo.
#   ./pj            trae pj-template al SHA de `template_ref` (proyecto.yml) en .pj/tpl y genera
#                   .agents/ y .cursor/ (fichas, reglas, skills). Corrélo después de cada clone o pull.
#   ./pj listo [--abrir]  todo de una después de un clone o pull: git pull --rebase --autostash,
#                   trae el template, genera, instala los hooks, enlaza las fichas en agy, clona los
#                   repos, corre check e imprime `agy --agent PM-<proyecto>` (--abrir lo arranca).
#   ./pj hooks      instala los hooks post-merge y post-checkout: cada `git pull` regenera solo.
#   ./pj onboard    la entrevista del onboarding (onboarding.yml: misión, no tocar, primeros pasos,
#                   cómo prueba el WK, qué exige el RV, repos). Idempotente: si ya está hecho, muestra
#                   los datos y pregunta qué cambiar. --mostrar solo imprime; --si/--respuestas F sin preguntas.
#   ./pj clean [--onboarding]  deshace ./pj listo para volver a probarlo: borra .pj/, lo generado en
#                   .agents/ y .cursor/, los hooks de pj, los enlaces de agy de este proyecto y los clones
#                   de repos sin trabajo local (los que tienen cambios o commits sin subir los deja y
#                   avisa). --onboarding además deja onboarding.yml y `repos:` sin hacer. Idempotente.
#   ./pj <target>   corre un target del Makefile del template: check, humo, clonar, agy, generar…
# Auth: PJ_TEMPLATE_TOKEN si está (CI); si no, `gh auth git-credential`. PJ_TEMPLATE_DIR=<checkout>
# usa un pj-template local en vez de bajarlo (pruebas). Python: crea .pj/venv (PyYAML + jsonschema)
# la primera vez; PY=<python> lo reemplaza.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
raiz="$PWD"
proy="$(sed -nE 's/^proyecto:[[:space:]]*["'\'']?([^"'\'' #]+).*$/\1/p' proyecto.yml)"
onboarding_hecho(){ sed -nE 's/^hecho:[[:space:]]*["'\'']?([0-9]{4}-[0-9]{2}-[0-9]{2}).*$/\1/p' onboarding.yml 2>/dev/null; }
limpiar(){ # ./pj clean [--onboarding]: no necesita el template ni Python.
  local onb=0 a n l d h dir algo=0 quedan=() motivo
  for a in "$@"; do case "$a" in --onboarding) onb=1 ;; *) echo "pj: clean no conoce $a" >&2; exit 2 ;; esac; done
  for n in PM WK RV; do
    l="$HOME/.gemini/config/agents/$n-$proy.md"
    [ -L "$l" ] || continue
    case "$(readlink "$l")" in "$raiz"/.agents/agents/*|"$(pwd -P)"/.agents/agents/*) rm -f "$l"; echo "pj: borrado enlace de agy $l"; algo=1 ;; esac
  done
  if d="$(git rev-parse --git-path hooks 2>/dev/null)"; then
    for h in post-merge post-checkout; do
      if [ -f "$d/$h" ] && grep -q '# pj-hook' "$d/$h"; then rm -f "$d/$h"; echo "pj: borrado hook $h"; algo=1; fi
    done
  fi
  while IFS= read -r dir; do
    [ -n "$dir" ] && [ -e "$dir" ] || continue
    motivo=""
    if [ ! -d "$dir/.git" ]; then motivo="no es un clon de git"
    elif [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then motivo="tiene cambios sin commitear"
    elif [ -n "$(git -C "$dir" log --branches --not --remotes --oneline 2>/dev/null)" ]; then motivo="tiene commits sin subir"
    elif [ -n "$(git -C "$dir" stash list 2>/dev/null)" ]; then motivo="tiene stash"
    fi
    if [ -n "$motivo" ]; then quedan+=("$dir ($motivo)"); else rm -rf "${dir:?}"; echo "pj: borrado clon $dir/"; algo=1; fi
  done < <(sed -nE 's/^[[:space:]]*-?[[:space:]]*dir:[[:space:]]*["'\'']?([A-Za-z0-9][A-Za-z0-9._-]*).*$/\1/p' proyecto.yml)
  if [ -d .agents ] || [ -d .cursor ]; then
    # Solo lo ignorado por git (lo generado); los extras versionados de proyecto.yml se quedan.
    local f g=0
    while IFS= read -r -d '' f; do rm -f "$f"; g=$((g+1)); done < <(git ls-files -z -o -i --exclude-standard -- .agents .cursor 2>/dev/null)
    find .agents .cursor -depth -type d -empty -delete 2>/dev/null || true
    if [ "$g" -gt 0 ]; then echo "pj: borrados $g archivos generados en .agents/ y .cursor/"; algo=1; fi
  fi
  if [ -d .pj ]; then rm -rf .pj; echo "pj: borrado .pj/ (template y venv)"; algo=1; fi
  if [ "$onb" = 1 ]; then
    local vacio; vacio="$(cat <<YML
# Onboarding del trío de $proy: lo propio del proyecto que reciben PM, WK y RV en su ficha.
# Lo escribe \`./pj onboard\` (entrevista); se puede editar a mano y correr \`./pj\`.
# hecho vacío = onboarding sin hacer. Esquema: schema/onboarding.schema.json de pj-template.
version: 1
hecho: ""
mision: ""
no_tocar: []
reglas_proyecto: []
primeros_pasos: []
wk:
  como_probar: []
rv:
  exige: []
YML
)"
    if [ "$(cat onboarding.yml 2>/dev/null)" != "$vacio" ]; then printf '%s\n' "$vacio" > onboarding.yml; echo "pj: onboarding.yml sin hacer"; algo=1; fi
    a="$(awk 's==1{ if ($0 ~ /^([[:space:]]+[^[:space:]]|- )/ && $0 !~ /^[[:space:]]*#/) next; s=2 } /^repos:/ && s==0 { print "repos: []"; s=1; next } { print }' proyecto.yml)"
    if [ "$a" != "$(cat proyecto.yml)" ]; then printf '%s\n' "$a" > proyecto.yml; echo "pj: repos de proyecto.yml vacíos"; algo=1; fi
  fi
  if [ "${#quedan[@]}" -gt 0 ]; then
    printf 'pj: no borré %s: guardá o subí ese trabajo y volvé a correr ./pj clean\n' "${quedan[@]}" >&2; exit 1
  fi
  if [ "$algo" = 1 ]; then echo "pj: limpio. Para rehacer: ./pj listo"; else echo "pj: nada que limpiar"; fi
}
[ "${1:-}" = clean ] && { shift; limpiar "$@"; exit 0; }
if [ "${1:-}" = listo ] && [ -z "${PJ_LISTO_PULL:-}" ]; then
  # Primero el pull (puede cambiar template_ref o este mismo script); después se vuelve a ejecutar.
  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "pj: git pull --rebase --autostash"
    git pull --rebase --autostash -q || echo "pj: aviso: el pull falló; sigo con lo que hay (resolvelo y volvé a correr ./pj listo)" >&2
  else echo "pj: la rama no tiene upstream; salto el pull" >&2; fi
  PJ_LISTO_PULL=1 exec "$raiz/pj" "$@"
fi
ref="$(sed -nE 's/^template_ref:[[:space:]]*["'\'']?([0-9a-f]{40})["'\'']?.*$/\1/p' proyecto.yml)"
[ -n "$ref" ] || { echo "pj: proyecto.yml no tiene template_ref (SHA de 40 caracteres de robert-flo/pj-template)" >&2; exit 1; }

if [ -n "${PJ_TEMPLATE_DIR:-}" ]; then
  tpl="$(cd "$PJ_TEMPLATE_DIR" && pwd)"
else
  tpl="$raiz/.pj/tpl"
  if [ "$(git -C "$tpl" rev-parse HEAD 2>/dev/null || true)" != "$ref" ]; then
    echo "pj: trayendo robert-flo/pj-template@${ref:0:12} en .pj/tpl"
    mkdir -p "$tpl"; git -C "$tpl" init -q 2>/dev/null || true
    url=https://github.com/robert-flo/pj-template.git
    if [ -n "${PJ_TEMPLATE_TOKEN:-}" ]; then
      auth="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$PJ_TEMPLATE_TOKEN" | base64 -w0)"
      git -C "$tpl" -c "http.https://github.com/.extraheader=$auth" fetch -q --depth 1 "$url" "$ref"
    elif command -v gh >/dev/null; then
      git -C "$tpl" -c credential.helper= -c 'credential.helper=!gh auth git-credential' fetch -q --depth 1 "$url" "$ref"
    else
      git -C "$tpl" fetch -q --depth 1 "$url" "$ref"
    fi
    git -C "$tpl" -c advice.detachedHead=false checkout -q --detach FETCH_HEAD
  fi
fi
export PJ_RAIZ="$raiz" PJ_TPL="$tpl"
# Python propio en .pj/venv con PyYAML y jsonschema (requirements.txt del template); nunca el del sistema.
PY="${PY:-$(bash "$tpl/scripts/py.sh")}"; export PY
for f in pj .github/workflows/pj-template.yml; do
  cmp -s "$tpl/plantillas/hijo/$(basename "$f")" "$f" || echo "pj: aviso: $f difiere del de pj-template@${ref:0:12} (el PR de sync lo actualiza)" >&2
done
instalar_hooks(){
  local d h; d="$(git rev-parse --git-path hooks 2>/dev/null)" || { echo "pj: no es un repo git; sin hooks" >&2; return 0; }
  mkdir -p "$d"
  for h in post-merge post-checkout; do
    if [ -e "$d/$h" ] && ! grep -q '# pj-hook' "$d/$h"; then echo "pj: salto $h (ya hay un hook propio)" >&2; continue; fi
    cat > "$d/$h" <<'HOOK'
#!/usr/bin/env bash
# pj-hook: lo instala ./pj hooks. Regenera .pj/, .agents/ y .cursor/ después de cada pull o cambio de rama.
[ "${0##*/}" = post-checkout ] && [ "${3:-1}" = 0 ] && exit 0
cd "$(git rev-parse --show-toplevel)" && [ -x ./pj ] || exit 0
./pj >/dev/null || echo "pj: aviso: no pude regenerar; corré ./pj listo" >&2
exit 0
HOOK
    chmod +x "$d/$h"
  done
  echo "pj: hooks post-merge y post-checkout instalados"
}
case "${1:-sync}" in
  sync) exec "$PY" "$tpl/scripts/generar.py" ;;
  hooks) instalar_hooks; exit 0 ;;
  listo)
    shift; abrir=0; for a in "$@"; do case "$a" in --abrir) abrir=1 ;; *) echo "pj: listo no conoce $a" >&2; exit 2 ;; esac; done
    "$PY" "$tpl/scripts/generar.py"
    instalar_hooks
    if [ -z "$(onboarding_hecho)" ] && [ -t 0 ] && [ -t 1 ]; then
      read -rp "pj: el onboarding del PM está sin hacer. ¿Lo hacemos ahora? [S/n] " r || r=n
      case "$r" in ""|s|S|si|sí|y|Y) "$PY" "$tpl/scripts/onboard.py" || true ;; esac
    fi
    make -s --no-print-directory -f "$tpl/Makefile" agy clonar check
    echo
    if f="$(onboarding_hecho)" && [ -n "$f" ]; then
      echo "pj: onboarding hecho el $f (./pj onboard lo muestra o lo cambia)."
      echo "pj: listo. Para arrancar:  agy --agent PM-$proy   (o abrí la carpeta en Cursor)"
    else
      echo "pj: falta el onboarding del PM. Corré:  ./pj onboard   (después: agy --agent PM-$proy)"
    fi
    if [ "$abrir" = 1 ]; then exec agy --agent "PM-$proy"; fi
    exit 0 ;;
  onboard) shift; exec "$PY" "$tpl/scripts/onboard.py" "$@" ;;
esac
"$PY" "$tpl/scripts/generar.py" >/dev/null
exec make -s --no-print-directory -f "$tpl/Makefile" "$@"
